{
  "id": "ella-puede-subtitle-studio",
  "name": "EllaPuede 字幕提取工具",
  "version": "0.14.4",
  "build": "32",
  "kind": "desktop-application-source",
  "platforms": [
    "macos-arm64",
    "windows-x64"
  ],
  "offline": true,
  "source_root": ".",
  "entrypoints": {
    "desktop": "launch.py",
    "ocr": "src/subtitle_ocr.py",
    "batch_worker": "src/batch_worker.py",
    "preview": "src/preview_worker.py",
    "build": "tools/build.py",
    "package": "tools/package_installers.py",
    "tests": "tests/test_*.py",
    "segmentation_diagnostics": "tools/analyze_segmentation.py"
  },
  "capabilities": [
    "burned-in-dialogue-ocr",
    "series-shared-subtitle-region",
    "automatic-language-hint",
    "korean-english-multilingual-ocr",
    "srt-export",
    "ass-export",
    "same-video-filename-export",
    "offline-batch-processing",
    "relink-moved-series-videos",
    "reexport-without-ocr",
    "selected-task-context-actions",
    "explicit-language-guard",
    "direct-selected-reprocessing",
    "running-job-stop-and-requeue",
    "direct-cached-reexport",
    "cross-script-temporal-flicker-repair",
    "image-verified-short-ocr-substitution",
    "interactive-stable-timeline-scrubbing",
    "forward-preview-decoder-reuse",
    "windows-independent-cpu-gpu-device-choice",
    "hardware-scaled-ocr-concurrency",
    "image-verified-brief-ocr-gap-repair",
    "learned-dialogue-band-endcard-filter",
    "on-demand-segmentation-diagnostics",
    "macos-stable-menu-selectors",
    "thai-offline-ocr",
    "independent-short-caption-verification",
    "vision-thai-on-macos15",
    "same-glyph-spacing-compaction",
    "volatile-observed-caption-compaction"
  ],
  "primary_workflow": "import-series -> select-dialogue-region-once -> choose-language-and-export-format -> run -> same-basename-auto-export",
  "region_policy": "manual-primary; automatic-only-when-explicitly-selected; shared-per-series-with-episode-override",
  "ocr_policy": "burned-in-dialogue-inside-roi; image-backed; no-audio-transcription; no-translation; no-semantic-fabrication",
  "progress_policy": "duration-weighted-project-work-fraction; scan-and-image-verification-are-distinct-stages",
  "product_contract": "docs/ARCHITECTURE.md",
  "handoff_instructions": "CONTRIBUTING.md",
  "models_path": "models",
  "python_version": "3.13",
  "working_directory": ".",
  "cli_argv": [
    "{python}",
    "launch.py",
    "--worker",
    "extract",
    "{input}",
    "-o",
    "{output}",
    "--language",
    "auto",
    "--format",
    "both"
  ],
  "stdout_event_prefix": "@@ELLAPUEDE@@",
  "integration_guide": "docs/CLI.md",
  "source_import_record": null,
  "repository": "https://github.com/joesun16/ellapuede-subtitle-studio",
  "release_source_commit": null,
  "release_tag": "v0.14.4",
  "release_ci_run": null,
  "installer_manifest": "docs/RELEASE-ASSETS-0.14.4.json",
  "development_status": "0.14.4 / build 32 公测；质量和长视频速度目标见 docs/QUALITY.md",
  "development_report": "docs/QUALITY.md",
  "operation_model": "docs/USER-GUIDE.md"
}
